# Based on github/gitignore Node.gitignore, trimmed to what this repo can hit.

# Logs
logs
*.log

# Dependency directories
node_modules/

# TypeScript cache
*.tsbuildinfo

# Output of 'npm pack'
*.tgz

# dotenv / secrets — never commit
.env
.env.*
*.key

# Finder (macOS)
.DS_Store
# Spotlight's "do not index" marker, which appears inside build output and
# would dirty the tree-clean gate on a Mac while never existing on CI.
.metadata_never_index

# bun is the canonical package manager: bun.lock is the tracked source of truth.
bun.lockb
package-lock.json

# Generated doc corpus
demo/docs.json

# TLS dev certs (bunx tosijs-dev-certs regenerates them)
tls/*.pem
tls/*.csr
.haltija/

# Library build output. Published from a clean build, never tracked.
dist/

# Doc-site output. Track this only once a Pages deploy points at it — until
# then it is a 10 MB rebuild artifact that would land in every commit.
# ⚠️ `docs/` IS THE PUBLISHED SITE AND IS COMMITTED — GitHub Pages serves it
# from `main` at ensemble.tosijs.net. Every sibling does the same (tosijs 59
# tracked files, tosijs-ui 164, tosijs-3d 2663); this repo ignoring it is why
# Pages has never once succeeded here.
#
# The SOURCE MAPS are the exception, following tosijs' precedent: they are
# 79 MB of the 106 MB and nothing reads them from the published site.
docs/*.map
docs/_chunks/*.map
docs.last-good/
llms.txt

# Asset collections live on the CDN, NOT in this repo.
#
# Two Kenney glbs (20 MB) went in by accident on one `git add -A` — a repo that
# carries its sample content grows without bound and every clone pays for it.
# Keep them in static/ locally so the dev server serves them; the deployed site
# and the ensembles point at cdn.tosijs.net.
static/*.glb
test-results/
playwright-report/

# Written into the repo root by tosijs-ui's dev server, so `bun start` and
# the Playwright webServer both dirty it mid-release. Nothing reads it, and a
# stale `passed: 6, failed: 0` standing in for a gate that no longer runs is
# worse than no file — see tosijs-ui#158.
.browser-tests.json

{
  "name": "tosijs-3d-ensemble",
  "version": "0.9.0",
  "description": "The tosijs-3d ensemble format, its instantiator, and a graphical editor for authoring ensembles.",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/iife.js",
    "!dist/iife.js.map",
    "!dist/__fixtures__",
    "CHANGELOG.md",
    "MIGRATING.md"
  ],
  "homepage": "https://ensemble.tosijs.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonioloewald/tosijs-3d-ensemble.git"
  },
  "license": "Apache-2.0",
  "scripts": {
    "start": "bun format && bun bin/site.ts",
    "build": "bun bin/site.ts --build && bun bin/sizes.ts",
    "test": "bun test",
    "test:scene": "bunx playwright test",
    "test:reparent": "bunx playwright test --project=reparent",
    "tests": "bun test && bunx playwright test --project=chromium && bunx playwright test --project=reparent",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "format": "bun prettier --write .",
    "format:check": "bun prettier --check .",
    "tls": "tosijs-dev-certs",
    "tunnel": "tosijs-tunnel",
    "deploy": "tosijs-deploy",
    "release:attest": "bun ../tosijs-coding-practices/tools/attest.ts",
    "sizes": "bun bin/sizes.ts --write"
  },
  "dependencies": {
    "tosijs-schema": "^1.14.0"
  },
  "peerDependencies": {
    "tosijs": "^1.10.11",
    "tosijs-3d": "^0.13.1",
    "@babylonjs/core": "^9.0.0"
  },
  "devDependencies": {
    "@babylonjs/core": "^9.37.0",
    "@babylonjs/gui": "^9.37.0",
    "@babylonjs/loaders": "^9.37.0",
    "@babylonjs/materials": "^9.37.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "1.65.1",
    "@types/bun": "latest",
    "chokidar": "^5.0.0",
    "happy-dom": "^21.0.4",
    "prettier": "^2.8.8",
    "tosijs": "1.10.11",
    "tosijs-3d": "0.13.1",
    "tosijs-ui": "^1.17.8",
    "typescript": "^5.9.3"
  },
  "releaseDoctor": {
    "attestedLanes": [
      "test:scene",
      "test:reparent"
    ]
  }
}
